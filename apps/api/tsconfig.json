{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@event-marketplace/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "*": [
        "./*"
      ]
    },
    "rootDirs": [
      "./src",
      "../../packages/shared-types/src"
    ],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*",
    "package.json"
  ],
}